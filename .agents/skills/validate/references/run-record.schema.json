{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Prodige-max/a-eye-validate/run-record.schema.json",
  "title": "A-EYE Validate run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "status", "validated_on", "scope", "counts", "evidence_lifecycle", "score", "confidence", "verdict", "top_unknown", "next_step", "evidence"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^AEYE-[0-9]{8}-[a-z0-9-]+-[a-f0-9]{8}$"},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "validated_on": {"type": "string", "format": "date"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["industry", "geography", "buyer", "workflow", "currency"],
      "properties": {
        "industry": {"type": "string", "minLength": 1},
        "geography": {"type": "string", "minLength": 1},
        "buyer": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 3}
      }
    },
    "counts": {
      "type": "object",
      "required": ["complainants", "affected_organizations", "unknown_identity_items", "offerings", "direct_fit"],
      "properties": {
        "complainants": {"type": ["integer", "null"], "minimum": 0},
        "affected_organizations": {"type": ["integer", "null"], "minimum": 0},
        "unknown_identity_items": {"type": ["integer", "null"], "minimum": 0},
        "offerings": {"type": ["integer", "null"], "minimum": 0},
        "direct_fit": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "evidence_lifecycle": {
      "type": "object",
      "required": ["reused", "refreshed", "new"],
      "properties": {
        "reused": {"type": "integer", "minimum": 0},
        "refreshed": {"type": "integer", "minimum": 0},
        "new": {"type": "integer", "minimum": 0}
      }
    },
    "score": {
      "type": "object",
      "required": ["low", "high"],
      "properties": {
        "low": {"type": "number", "minimum": 0, "maximum": 100},
        "high": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "confidence": {"enum": ["low", "medium", "high"]},
    "verdict": {"enum": ["pilot", "interview first", "re-scope", "deprioritize"]},
    "top_unknown": {"type": "string", "minLength": 1},
    "next_step": {"type": "string", "minLength": 1},
    "notion_page_url": {"type": ["string", "null"], "format": "uri"},
    "save_error": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "type", "last_verified", "lifecycle"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]{2,}$"},
          "url": {"type": "string", "format": "uri"},
          "type": {"enum": ["firsthand complaint", "workaround", "buying signal", "solution", "benchmark", "secondary commentary"]},
          "last_verified": {"type": "string", "format": "date"},
          "lifecycle": {"enum": ["reused", "refreshed", "new"]}
        }
      }
    }
  }
}

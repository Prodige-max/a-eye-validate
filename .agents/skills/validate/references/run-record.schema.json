{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Prodige-max/a-eye-validate/run-record.schema.json",
  "title": "A-EYE Validate run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "status", "validated_on", "scope", "independent_research", "counts", "evidence_lifecycle", "dimension_scores", "roi", "score", "confidence", "market_test_stage", "pilot_gates", "verdict", "top_unknown", "next_step", "evidence"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^AEYE-[0-9]{8}-[a-z0-9-]+-[a-f0-9]{8}$"},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "validated_on": {"type": "string", "format": "date"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["industry", "geography", "buyer", "workflow", "currency"],
      "properties": {
        "industry": {"type": "string", "minLength": 1},
        "geography": {"type": "string", "minLength": 1},
        "buyer": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 3}
      }
    },
    "independent_research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "fresh_search_date", "groups_attempted", "limitations"],
      "properties": {
        "completed": {"type": "boolean"},
        "fresh_search_date": {"type": ["string", "null"], "format": "date"},
        "groups_attempted": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["complaints/workarounds", "products/services", "cost/resource benchmarks", "technical/operational verification"]}
        },
        "limitations": {"type": ["string", "null"]}
      }
    },
    "counts": {
      "type": "object",
      "required": ["complainants", "affected_organizations", "unknown_identity_items", "offerings", "direct_fit"],
      "properties": {
        "complainants": {"type": ["integer", "null"], "minimum": 0},
        "affected_organizations": {"type": ["integer", "null"], "minimum": 0},
        "unknown_identity_items": {"type": ["integer", "null"], "minimum": 0},
        "offerings": {"type": ["integer", "null"], "minimum": 0},
        "direct_fit": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "evidence_lifecycle": {
      "type": "object",
      "required": ["reused", "refreshed", "new"],
      "properties": {
        "reused": {"type": "integer", "minimum": 0},
        "refreshed": {"type": "integer", "minimum": 0},
        "new": {"type": "integer", "minimum": 0}
      }
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demand", "unmet_need", "net_savings", "feasibility"],
      "properties": {
        "demand": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
        "unmet_need": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
        "net_savings": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
        "feasibility": {"type": ["integer", "null"], "minimum": 0, "maximum": 5}
      }
    },
    "roi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "low_percent", "base_percent", "high_percent", "base_payback_months", "cash_realization"],
      "properties": {
        "basis": {"enum": ["measured", "sourced", "mixed", "hypothetical", "unknown"]},
        "low_percent": {"type": ["number", "null"]},
        "base_percent": {"type": ["number", "null"]},
        "high_percent": {"type": ["number", "null"]},
        "base_payback_months": {"type": ["number", "null"], "minimum": 0},
        "cash_realization": {"type": ["boolean", "null"]}
      }
    },
    "score": {
      "type": "object",
      "required": ["low", "high"],
      "properties": {
        "low": {"type": "number", "minimum": 0, "maximum": 100},
        "high": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "confidence": {"enum": ["low", "medium", "high"]},
    "market_test_stage": {"enum": ["hypothesis", "public evidence", "buyer discovery", "baseline validated", "controlled pilot", "repeatability proven"]},
    "pilot_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_buyer_pain", "incumbent_comparison", "validated_operating_baseline", "plausible_integration_route"],
      "properties": {
        "verified_buyer_pain": {"type": "boolean"},
        "incumbent_comparison": {"type": "boolean"},
        "validated_operating_baseline": {"type": "boolean"},
        "plausible_integration_route": {"type": "boolean"}
      }
    },
    "verdict": {"enum": ["pilot", "interview first", "re-scope", "deprioritize"]},
    "top_unknown": {"type": "string", "minLength": 1},
    "next_step": {"type": "string", "minLength": 1},
    "notion_page_url": {"type": ["string", "null"], "format": "uri"},
    "save_error": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "type", "relationship", "last_verified", "lifecycle"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]{2,}$"},
          "url": {"type": "string", "format": "uri"},
          "type": {"enum": ["firsthand complaint", "workaround", "buying signal", "solution", "benchmark", "secondary commentary"]},
          "relationship": {"enum": ["independent", "incumbent/vendor", "operator-supplied", "unknown"]},
          "last_verified": {"type": "string", "format": "date"},
          "lifecycle": {"enum": ["reused", "refreshed", "new"]}
        }
      }
    }
  }
}

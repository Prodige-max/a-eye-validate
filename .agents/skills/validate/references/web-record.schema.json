{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Prodige-max/a-eye-validate/web-record.schema.json",
  "title": "A-EYE bounded web collection record",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "source_url", "fetched_at", "status", "depth", "robots"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_url": {"type": "string", "format": "uri"},
    "final_url": {"type": ["string", "null"], "format": "uri"},
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "duplicate", "blocked", "rejected", "error"]},
    "http_status": {"type": ["integer", "null"]},
    "content_type": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "author": {"type": ["string", "null"]},
    "published_date": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "text": {"type": ["string", "null"]},
    "content_json": {},
    "text_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "raw_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": ["integer", "null"], "minimum": 0},
    "links": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "depth": {"type": "integer", "minimum": 0},
    "parent_url": {"type": ["string", "null"]},
    "robots": {"enum": ["allowed", "disallowed", "unavailable", "not_checked"]},
    "duplicate_of": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]}
  }
}
